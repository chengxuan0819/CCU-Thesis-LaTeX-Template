{
    // 設定 LaTeX Workshop 預設使用 latexmk (xelatex)
    "latex-workshop.latex.recipes": [
        {
        "name": "latexmk (xelatex)",
        "tools": ["xelatexmk"]
        }
    ],
    "latex-workshop.latex.tools": [
        {
        "name": "xelatexmk",
        "command": "latexmk",
        "args": [
            "-synctex=1",
            "-interaction=nonstopmode",
            "-file-line-error",
            "-xelatex",
            "-shell-escape",
            "-outdir=%OUTDIR%",
            "%DOC%"
        ],
        "env": {}
        }
    ],

    // 可選參數
    "latex-workshop.latex.autoBuild.run": "onSave",         // 當儲存時自動編譯
    "latex-workshop.latex.autoClean.run": "onSucceeded",    // 當編譯成功時自動清理

    // 圖片模板 figure template
    "latex-utilities.formattedPaste.image.template": [
        "\\begin{figure}[!htb]",
        "\t\\centering",
        "\t\\includegraphics[width=\\textwidth]{${imageFilePath}}",
        "\t\\caption{${imageFileNameWithoutExt}}",
        "\t\\label{fig:${imageFileNameWithoutExt}}",
        "\\end{figure}",
        ""
    ],
    "files.autoSave": "onFocusChange",
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/01introduction.aux": true,
        "**/01introduction.log": true,
        "**/01introduction.gz": true,
        "**/01introduction.out": true,
        "**/02related_work.aux": true,
        "**/02related_work.log": true,
        "**/02related_work.gz": true,
        "**/02related_work.out": true,
        "**/03method.aux": true,
        "**/03method.log": true,
        "**/03method.gz": true,
        "**/03method.out": true,
        "**/05conclusion.aux": true,
        "**/05conclusion.log": true,
        "**/05conclusion.gz": true,
        "**/05conclusion.out": true,
        "**/04experiments.aux": true,
        "**/04experiments.log": true,
        "**/04experiments.gz": true,
        "**/04experiments.out": true
    }
}